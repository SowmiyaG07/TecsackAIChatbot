    }
  },
  {
    "element_type": "paragraph",
    "text": "Casual Leave\nThe purpose of the casual Leave Policy is to grant days off from work to an\nemployee in the event of his/her Personal work or commitments. It should be Planned\nleave accordingly.",
    "page": 3,
    "heading_level": null,
    "heading_path": [
      "TECSACK India Policy - Leave Policy"
    ],
    "metadata": {
      "extraction_method": "pymupdf"
    }
